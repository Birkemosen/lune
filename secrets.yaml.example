# Copy to secrets.yaml at the repository root (gitignored) and fill in your own
# values. The Lune V6 Makefile links configurations/secrets.yaml to this file.
#
# Only the first four keys are referenced by the Lune V6 firmware; the MQTT keys
# are kept for configurations that enable an MQTT broker.
#
# `!secret` is resolved while the YAML is loaded, so every key below must exist
# even for a release build that removes the station block. CI writes a file with
# exactly these placeholder values — see
# .github/workflows/build-release-firmware.yml.

wifi_ssid: "your-wifi-ssid"
wifi_password: "your-wifi-password"

# Native API encryption key: 32 random bytes, base64-encoded. Generate with
#   openssl rand -base64 32
api_key: "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="

ota_password: "your-ota-password"

mqtt_broker: "127.0.0.1"
mqtt_port: "1883"
mqtt_username: "mqtt-user"
mqtt_password: "mqtt-password"
