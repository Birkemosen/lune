	(text "3 x DRV8411 / SIX CURRENT-LIMITED MOTOR OUTPUTS"
		(exclude_from_sim no)
		(at 63 275 0.0000)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
		)
		(uuid "b06fd642-d360-47a0-9421-504540889407")
	)
	(text "Motor ESD is one GND-referenced TPD1E10B06 per wire at its own connector pin. Do not substitute a rail-clamp"
		(exclude_from_sim no)
		(at 105 470 0.0000)
		(effects
			(font
				(size 1 1)
			)
		)
		(uuid "ec465e8a-699a-4b63-afde-03e2435a60bf")
	)
	(text "array (USBLC6 class): its VBUS pin steers positive strikes into +3V3_MOTOR, i.e. into DRV8411 VM and INA180 IN-."
		(exclude_from_sim no)
		(at 105 479 0.0000)
		(effects
			(font
				(size 1 1)
			)
		)
		(uuid "5dbd1c06-7044-4c44-b7d7-806b317bfde5")
	)
	(text "1R xISEN gives a 178..232 mA bridge ceiling: a board-protection backstop, ~4x above the 23..50 mA measured stall."
		(exclude_from_sim no)
		(at 105 443 0.0000)
		(effects
			(font
				(size 1 1)
			)
		)
		(uuid "e5edb8eb-3394-4bbe-b8cd-95b7f37207fe")
	)
	(text "xISEN is a production tuning parameter. 1.5R -> 119..155 mA sits just above the 100 mA firmware cap; do not"
		(exclude_from_sim no)
		(at 105 452 0.0000)
		(effects
			(font
				(size 1 1)
			)
		)
		(uuid "15a86475-9ebe-4f1d-9447-397073d71969")
	)
	(text "narrow it before the section 3 current distributions exist, or the prototype clips the data it must collect."
		(exclude_from_sim no)
		(at 105 461 0.0000)
		(effects
			(font
				(size 1 1)
			)
		)
		(uuid "b26d3f56-9b39-4572-b77f-27c1d1112002")
	)
