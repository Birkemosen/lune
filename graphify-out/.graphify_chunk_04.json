    {
      "id": "devices_lune_v6_hardware_lune_v6_rev3_1_lean_validation_plan_measured_endpoint_safety_evidence",
      "label": "Measured endpoint safety evidence",
      "file_type": "rationale",
      "source_file": "/Users/birkemose/workspace/github.com/birkemosen/heatvalve-6/devices/lune-v6/hardware/lune-v6-rev3.1-lean/validation-plan.md",
