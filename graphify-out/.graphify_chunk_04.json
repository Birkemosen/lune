      "contributor": ""
    },
    {
      "id": "devices_lune_v6_hardware_lune_v6_rev3_1_lean_architecture_shared_current_measurement",
      "label": "Shared calibrated current measurement",
      "file_type": "concept",
      "source_file": "/Users/birkemose/workspace/github.com/birkemosen/heatvalve-6/devices/lune-v6/hardware/lune-v6-rev3.1-lean/architecture.md",
      "source_location": "lines 61-80",
      "source_url": "",
      "captured_at": "",
      "author": "",
      "contributor": ""
    },
    {
      "id": "devices_lune_v6_hardware_lune_v6_rev3_1_lean_architecture_buffered_differential_bemf",
      "label": "Buffered sequential differential BEMF",
      "file_type": "rationale",
      "source_file": "/Users/birkemose/workspace/github.com/birkemosen/heatvalve-6/devices/lune-v6/hardware/lune-v6-rev3.1-lean/architecture.md",
      "source_location": "lines 82-104",
      "source_url": "",
      "captured_at": "",
      "author": "",
      "contributor": "",
      "rationale": "The TLV9001 buffer isolates the 47k terminal taps and mux resistance from the ESP32 sampling capacitor, avoiding acquisition-dependent BEMF errors while retaining transient-current limiting."
    },
    {
      "id": "devices_lune_v6_hardware_lune_v6_rev3_1_lean_architecture_bidirectional_endpoint_classifier",
      "label": "Bidirectional endpoint classifier",
      "file_type": "rationale",
      "source_file": "/Users/birkemose/workspace/github.com/birkemosen/heatvalve-6/devices/lune-v6/hardware/lune-v6-rev3.1-lean/architecture.md",
      "source_location": "lines 106-131",
      "source_url": "",
      "captured_at": "",
      "author": "",
      "contributor": "",
      "rationale": "Separate open and close learning combines current, observed then stopped commutation, debounce, and plausible travel time to distinguish normal endpoints, jams, disconnects, and sensor faults."
    },
    {
      "id": "devices_lune_v6_hardware_lune_v6_rev3_1_lean_architecture_independent_runtime_cutoff",
      "label": "74HC4060 independent runtime cutoff",
      "file_type": "rationale",
      "source_file": "/Users/birkemose/workspace/github.com/birkemosen/heatvalve-6/devices/lune-v6/hardware/lune-v6-rev3.1-lean/architecture.md",
      "source_location": "lines 133-144",
      "source_url": "",
      "captured_at": "",
      "author": "",
      "contributor": "",
      "rationale": "The hardware timer bounds harm if the ESP32, ADC, mux, or firmware fails; it supplements rather than performs endpoint detection."
    },
    {
      "id": "devices_lune_v6_hardware_lune_v6_rev3_1_lean_architecture_display_population_option",
      "label": "Display daughterboard population option",
      "file_type": "rationale",
      "source_file": "/Users/birkemose/workspace/github.com/birkemosen/heatvalve-6/devices/lune-v6/hardware/lune-v6-rev3.1-lean/architecture.md",
      "source_location": "lines 146-157",
      "source_url": "",
      "captured_at": "",
      "author": "",
      "contributor": "",
      "rationale": "A fixed display is deferred until enclosure and connector mechanics are known because common modules vary and contribute no safety function."
    },
    {
      "id": "devices_lune_v6_hardware_lune_v6_rev3_1_lean_architecture_two_layer_layout_rules",
