    {
      "id": "devices_lune_v6_hardware_lune_v6_rev3_1_lean_architecture_electrical_architecture",
      "label": "Rev 3.1 Lean electrical architecture",
      "file_type": "document",
      "source_file": "/Users/birkemose/workspace/github.com/birkemosen/heatvalve-6/devices/lune-v6/hardware/lune-v6-rev3.1-lean/architecture.md",
      "source_location": "lines 1-174",
