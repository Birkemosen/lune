    },
    {
      "id": "devices_lune_v6_hardware_lune_v6_rev3_1_lean_rev2_review_addendum_rev2_1_review_addendum",
      "label": "Rev 2.1 review addendum",
      "file_type": "document",
      "source_file": "/Users/birkemose/workspace/github.com/birkemosen/heatvalve-6/devices/lune-v6/hardware/lune-v6-rev3.1-lean/rev2-review-addendum.md",
      "source_location": "lines 1-57",
      "source_url": "",
      "captured_at": "",
      "author": "",
      "contributor": ""
    },
    {
      "id": "devices_lune_v6_hardware_lune_v6_rev3_1_lean_rev2_review_addendum_rev2_1_no_fabrication",
      "label": "Rev 2.1 no-fabrication disposition",
      "file_type": "rationale",
      "source_file": "/Users/birkemose/workspace/github.com/birkemosen/heatvalve-6/devices/lune-v6/hardware/lune-v6-rev3.1-lean/rev2-review-addendum.md",
      "source_location": "lines 9-27",
      "source_url": "",
      "captured_at": "",
      "author": "",
      "contributor": "",
      "rationale": "Rev 2.1 contains unqualified switches, firmware-only selection, unsafe latch and analog details, coupled motor and logic power, missing hard ceilings and timeout, reversed TVS polarity, and an unrouted oversized PCB."
    },
    {
      "id": "devices_lune_v6_hardware_lune_v6_rev3_1_lean_rev2_review_addendum_retained_force_motion_principle",
      "label": "Retained force-plus-motion principle",
      "file_type": "rationale",
      "source_file": "/Users/birkemose/workspace/github.com/birkemosen/heatvalve-6/devices/lune-v6/hardware/lune-v6-rev3.1-lean/rev2-review-addendum.md",
      "source_location": "lines 29-39",
      "source_url": "",
      "captured_at": "",
      "author": "",
      "contributor": "",
      "rationale": "Current observes force, load, jam, and connection while BEMF independently observes rotor motion, so both physical observations are preserved in the Lean design."
    },
    {
      "id": "devices_lune_v6_hardware_lune_v6_rev3_1_lean_rev2_review_addendum_six_not_eight",
      "label": "Six channels instead of eight",
      "file_type": "rationale",
      "source_file": "/Users/birkemose/workspace/github.com/birkemosen/heatvalve-6/devices/lune-v6/hardware/lune-v6-rev3.1-lean/rev2-review-addendum.md",
      "source_location": "lines 41-48",
      "source_url": "",
      "captured_at": "",
      "author": "",
      "contributor": "",
      "rationale": "Six channels meet the installation need, remove a driver group and two connectors, shorten the board edge, and improve two-layer routing margin."
    },
    {
      "id": "devices_lune_v6_hardware_lune_v6_rev3_1_lean_rev2_review_addendum_protected_integrated_bridges",
      "label": "Protected integrated bridges over discrete bridges",
      "file_type": "rationale",
      "source_file": "/Users/birkemose/workspace/github.com/birkemosen/heatvalve-6/devices/lune-v6/hardware/lune-v6-rev3.1-lean/rev2-review-addendum.md",
      "source_location": "lines 50-57",
      "source_url": "",
      "captured_at": "",
      "author": "",
      "contributor": "",
      "rationale": "At five-unit prototype volume, protected dual H-bridge ICs require fewer placements and less characterized safety behavior than discrete bridges; DRV8214 is too expensive and insufficiently stocked."
    },
