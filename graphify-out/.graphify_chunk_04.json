      "contributor": ""
    },
    {
      "id": "devices_lune_v6_hardware_lune_v6_rev3_1_lean_architecture_separated_logic_and_motor_power",
      "label": "Separated logic and motor power",
      "file_type": "rationale",
      "source_file": "/Users/birkemose/workspace/github.com/birkemosen/heatvalve-6/devices/lune-v6/hardware/lune-v6-rev3.1-lean/architecture.md",
      "source_location": "lines 5-12",
      "source_url": "",
      "captured_at": "",
      "author": "",
      "contributor": "",
      "rationale": "Separate 3V3_LOGIC and 3V3_MOTOR rails prevent stall and commutation disturbances from corrupting ADC evidence or resetting the ESP32."
    },
    {
      "id": "devices_lune_v6_hardware_lune_v6_rev3_1_lean_architecture_drv8411_current_ceiling",
      "label": "DRV8411 fixed current ceiling",
      "file_type": "concept",
      "source_file": "/Users/birkemose/workspace/github.com/birkemosen/heatvalve-6/devices/lune-v6/hardware/lune-v6-rev3.1-lean/architecture.md",
      "source_location": "lines 32-42",
