      "captured_at": "",
      "author": "",
      "contributor": ""
    },
    {
      "id": "devices_lune_v6_hardware_lune_v6_rev3_1_lean_architecture_74hc4514_one_hot_control",
      "label": "74HC4514 one-hot motor control",
      "file_type": "concept",
      "source_file": "/Users/birkemose/workspace/github.com/birkemosen/heatvalve-6/devices/lune-v6/hardware/lune-v6-rev3.1-lean/architecture.md",
      "source_location": "lines 44-59",
