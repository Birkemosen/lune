    },
    {
      "id": "devices_lune_v6_hardware_lune_v6_rev3_1_lean_readme_six_channel_decision",
      "label": "Six-channel product decision",
      "file_type": "rationale",
      "source_file": "/Users/birkemose/workspace/github.com/birkemosen/heatvalve-6/devices/lune-v6/hardware/lune-v6-rev3.1-lean/README.md",
      "source_location": "lines 12-14",
      "source_url": "",
      "captured_at": "",
      "author": "",
      "contributor": "",
      "rationale": "Six channels meet the actual product need; channels seven and eight do not save enough feeder cost to justify their added connector, driver, protection, and board-edge requirements."
    },
    {
      "id": "devices_lune_v6_hardware_lune_v6_rev3_1_lean_readme_drv8411_h_bridges",
      "label": "Three dual DRV8411PWPR H-bridges",
      "file_type": "concept",
      "source_file": "/Users/birkemose/workspace/github.com/birkemosen/heatvalve-6/devices/lune-v6/hardware/lune-v6-rev3.1-lean/README.md",
      "source_location": "lines 15-17",
      "source_url": "",
      "captured_at": "",
      "author": "",
      "contributor": ""
    },
    {
      "id": "devices_lune_v6_hardware_lune_v6_rev3_1_lean_readme_one_hot_drive_path",
      "label": "Physically one-hot drive path",
      "file_type": "rationale",
      "source_file": "/Users/birkemose/workspace/github.com/birkemosen/heatvalve-6/devices/lune-v6/hardware/lune-v6-rev3.1-lean/README.md",
      "source_location": "lines 18-19",
      "source_url": "",
      "captured_at": "",
      "author": "",
      "contributor": "",
      "rationale": "An active-high 4-to-16 decoder ensures only one bridge input is driven, making shared current and BEMF attribution deterministic."
    },
    {
      "id": "devices_lune_v6_hardware_lune_v6_rev3_1_lean_readme_force_and_motion_endpoint_evidence",
      "label": "Force-and-motion endpoint evidence",
      "file_type": "rationale",
      "source_file": "/Users/birkemose/workspace/github.com/birkemosen/heatvalve-6/devices/lune-v6/hardware/lune-v6-rev3.1-lean/README.md",
      "source_location": "lines 20-24",
      "source_url": "",
      "captured_at": "",
      "author": "",
      "contributor": "",
      "rationale": "Endpoint classification requires direction-specific current and BEMF motion evidence; neither signal is accepted alone."
    },
    {
      "id": "devices_lune_v6_hardware_lune_v6_rev3_1_lean_readme_nested_protection_layers",
      "label": "Nested motor protection layers",
      "file_type": "rationale",
      "source_file": "/Users/birkemose/workspace/github.com/birkemosen/heatvalve-6/devices/lune-v6/hardware/lune-v6-rev3.1-lean/README.md",
      "source_location": "lines 25-27",
      "source_url": "",
      "captured_at": "",
      "author": "",
      "contributor": "",
      "rationale": "Fixed bridge regulation, rail overcurrent, a persistent latch, firmware limits, and an independent hardware timer prevent a single failure from leaving a motor energized."
    },
    {
      "id": "devices_lune_v6_hardware_lune_v6_rev3_1_lean_readme_optional_display_interface",
      "label": "Optional display pads",
      "file_type": "rationale",
      "source_file": "/Users/birkemose/workspace/github.com/birkemosen/heatvalve-6/devices/lune-v6/hardware/lune-v6-rev3.1-lean/README.md",
      "source_location": "lines 28-30",
      "source_url": "",
      "captured_at": "",
      "author": "",
      "contributor": "",
      "rationale": "Unpopulated I2C pads preserve a display option without the area and assembly cost of an onboard OLED that adds no heating-safety function."
    },
    {
      "id": "devices_lune_v6_hardware_lune_v6_rev3_1_lean_readme_size_assembly_and_cost_target",
